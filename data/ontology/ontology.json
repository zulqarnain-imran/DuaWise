{
  "version": "1.0",
  "status": "DRAFT - requires review by a qualified Islamic scholar before use in a published system",
  "notes": [
    "situation = the user's circumstance. emotion = the user's feeling. topic = the subject matter of the dua. These are deliberately distinct and are the most common source of annotation disagreement.",
    "Every label must be supportable by a line in the source's own context. If the source does not state why the dua is prescribed, record occasion 'general' and flag for adjudication. Do not infer context from the Arabic alone.",
    "All label sets are multi-label. A travel dua is also a protection dua and a fear dua."
  ],
  "situations": [
    {
      "term_id": "sadness",
      "definition": "User describes feeling low, unhappy, or discouraged.",
      "includes": [
        "feeling low",
        "unhappy",
        "discouraged"
      ],
      "excludes": [
        "grief over a death - use death_of_loved_one"
      ]
    },
    {
      "term_id": "stress",
      "definition": "User describes pressure, overwhelm, or being unable to cope.",
      "includes": [
        "overwhelmed",
        "too much pressure",
        "burnt out"
      ],
      "excludes": [
        "worry about a specific outcome - use uncertainty_about_future"
      ]
    },
    {
      "term_id": "anxiety",
      "definition": "User describes worry, unease, or fear of what may happen.",
      "includes": [
        "worried",
        "nervous",
        "uneasy",
        "panic"
      ],
      "excludes": [
        "acute danger - use fear"
      ]
    },
    {
      "term_id": "fear",
      "definition": "User describes fear of a specific present threat.",
      "includes": [
        "afraid",
        "frightened",
        "scared"
      ],
      "excludes": [
        "general worry - use anxiety"
      ]
    },
    {
      "term_id": "financial_difficulty",
      "definition": "User describes inability to meet financial needs.",
      "includes": [
        "no money",
        "can't afford",
        "short of money",
        "bills"
      ],
      "excludes": [
        "specifically borrowing money - also label debt"
      ]
    },
    {
      "term_id": "debt",
      "definition": "User describes owing money or repayment difficulty.",
      "includes": [
        "loan",
        "owe money",
        "repay"
      ],
      "excludes": []
    },
    {
      "term_id": "unemployment",
      "definition": "User describes loss of work or difficulty finding work.",
      "includes": [
        "unemployed",
        "jobless",
        "laid off",
        "no job"
      ],
      "excludes": []
    },
    {
      "term_id": "illness",
      "definition": "User or someone close is unwell.",
      "includes": [
        "sick",
        "unwell",
        "diagnosis",
        "hospital",
        "pain",
        "surgery"
      ],
      "excludes": [
        "death - use death_of_loved_one"
      ]
    },
    {
      "term_id": "death_of_loved_one",
      "definition": "A death has occurred or is imminent.",
      "includes": [
        "died",
        "passed away",
        "funeral",
        "mourning"
      ],
      "excludes": []
    },
    {
      "term_id": "travel",
