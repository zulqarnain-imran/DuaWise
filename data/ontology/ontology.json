    {
      "term_id": "hardship",
      "definition": "User describes a general difficulty or affliction with no more specific cause given.",
      "includes": [
        "hardship",
        "difficulty",
        "affliction",
        "hard time"
      ],
      "excludes": [
        "a named cause - prefer the specific situation term"
      ]
    },
    {
      "term_id": "injustice",
      "definition": "User describes being treated unfairly or oppressed.",
      "includes": [
        "unfair",
        "oppressed",
        "wronged",
        "cheated"
      ],
      "excludes": []
